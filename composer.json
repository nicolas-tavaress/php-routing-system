{
    "name": "nicolas/php-routing-system",
    "description": "Mini roteador MVC em PHP 8.5",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "symfony/var-dumper": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "authors": [
        {
            "name": "Nicolas Tavares",
            "email": "nic.jundiai@gmail.com"
        }
    ]
}
